{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/orlando-vazquez-career/astra-protocol/templates/deployments.schema.json",
  "title": "ASTRA deployments registry",
  "description": "Registro de todo lo desplegado por un proyecto ASTRA (.astra/deployments.json). Axioma A4: toda direccion desplegada queda registrada. Lo escribe `astra deployments add`; cualquier herramienta puede leerlo.",
  "type": "object",
  "required": ["version", "deployments"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "deployments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "chain", "family", "network", "kind", "label", "address", "date", "verified"],
        "properties": {
          "id": { "type": "string", "pattern": "^dpl_[0-9]{8}_[0-9]+$", "description": "dpl_<YYYYMMDD>_<n>" },
          "chain": { "type": "string", "description": "Id de cadena del registro de astra-cli (ej: stellar-testnet, base, syscoin-nevm)." },
          "family": { "type": "string", "enum": ["stellar", "evm", "utxo"] },
          "network": { "type": "string", "enum": ["mainnet", "testnet"] },
          "kind": { "type": "string", "enum": ["contract", "token", "account", "other"] },
          "label": { "type": "string", "minLength": 1 },
          "address": { "type": "string", "description": "Validada por familia: StrKey (SEP-0023), EIP-55 o bech32/base58 de Syscoin." },
          "tx": { "type": "string", "description": "Hash de la transaccion de deploy: 0x + 64 hex en EVM; 64 hex en Stellar." },
          "commit": { "type": "string", "description": "SHA del commit desplegado." },
          "wasmHash": { "type": "string", "description": "Hash del WASM (Soroban)." },
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "verified": { "type": "boolean", "description": "true solo cuando el codigo fuente (o el hash de WASM) esta verificado publicamente (A6)." },
          "verificationUrl": { "type": "string", "pattern": "^https://" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
